# Copia este archivo como .env.local (para probar en tu computador)
# o crea estas mismas variables en Vercel > Settings > Environment Variables.

# Llaves del usuario IAM "marca-flexi-poc" (AWS > IAM > Users > Security credentials)
MF_AWS_ACCESS_KEY_ID=
MF_AWS_SECRET_ACCESS_KEY=

# Región de AWS donde se hace todo (us-east-1 = Virginia, tiene Face Liveness)
MF_AWS_REGION=us-east-1

# Nombre de la colección donde se guardan las plantillas faciales
MF_COLECCION=marca-flexi-poc

# Puntaje mínimo de la prueba de vida (0 a 100) para aceptar que es una persona real
MF_UMBRAL_VIDA=80

# Parecido mínimo (0 a 100) para aceptar que la cara es la de la persona registrada
MF_UMBRAL_SIMILITUD=95

# Usuario y clave para entrar a la plataforma (protege tu cuenta de AWS)
MF_USUARIO=marcaflexi
MF_CLAVE=
